{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DGCU Portal",
  "version": "0.1.2",
  "identifier": "net.dgcu.portal",
  "build": {
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 760,
        "height": 620,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "incognito": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; script-src 'self'; img-src 'self' data:; object-src 'none'; frame-src 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
