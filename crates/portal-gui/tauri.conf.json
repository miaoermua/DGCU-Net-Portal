{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DGCU Portal",
  "version": "0.1.0",
  "identifier": "net.dgcu.portal",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "title": "DGCU 校园网认证",
        "width": 980,
        "height": 720,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
