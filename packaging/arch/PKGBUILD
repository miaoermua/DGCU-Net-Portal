# Maintainer: DGCU-Net-Portal CI <https://github.com/miaoermua/DGCU-Net-Portal>
# 本 PKGBUILD 只负责安装布局：二进制由 .github/workflows/build.yml 的 Linux
# 构建任务交叉产出后放入 target/arch/，再由 Arch 容器内的 makepkg 打包。
pkgname=dgcu-net-portal
pkgver=0.0.0
pkgrel=1
pkgdesc='DGCU 校园网 Portal 客户端（GUI + CLI）'
arch=('x86_64' 'aarch64')
url='https://github.com/miaoermua/DGCU-Net-Portal'
license=('GPL-3.0-only')
depends=('gtk3' 'webkit2gtk-4.1' 'libayatana-appindicator' 'libsecret')
options=('!strip')
source=('portal-gui' 'portal-cli' 'dgcu-portal.desktop' 'portal-gui.png' 'LICENSE')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "$srcdir/portal-gui" "$pkgdir/usr/bin/portal-gui"
  install -Dm755 "$srcdir/portal-cli" "$pkgdir/usr/bin/portal-cli"
  install -Dm644 "$srcdir/dgcu-portal.desktop" "$pkgdir/usr/share/applications/dgcu-portal.desktop"
  install -Dm644 "$srcdir/portal-gui.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/portal-gui.png"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
